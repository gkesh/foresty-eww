                :vexpand "false"
                :valign "fill"
                :hexpand "true"
                :halign "center"
                :onmiddleclick "reboot -f"
            
                (box :orientation "h" 
                    :valign "center"
                    :vexpand "false"
                    :halign "center"
                    :hexpand "true"
                    :space-evenly "false"
                    :spacing 4

                    (label :class "large-icon"
                        :text " ")

                    (label :class "large-icon"
                        :text " ")
                    
                    (label :class "large-icon"
                        :text " 󰸳 ")
                    
                    ; (label :class "rounded-label"
                    ;     :halign "center"
                    ;     :text "Restart")
                )
            )
        )

        (box  :class "control-box"
            :tooltip mode_text
            :space-evenly "false"
            :valign "fill"
            :vexpand "false"
            :halign "fill"
            :hexpand "true"
            :spacing 16

            (eventbox :class "restart-button"
                :cursor "pointer"
                :onrightclick ""
                :vexpand "false"
                :valign "fill"
                :hexpand "true"
                :halign "center"
                :onmiddleclick "qtile cmd-obj -o cmd -f reload_config"
            
                (box :orientation "h" 
                    :valign "center"
                    :vexpand "false"
                    :halign "center"
                    :hexpand "true"
                    :space-evenly "false"
                    :spacing 4

                    (label :class "large-icon"
                        :text " ")

                    (label :class "large-icon"
                        :text " ")
                    
                    (label :class "large-icon"
                        :text "  ")
                    
                    ; (label :class "rounded-label"
                    ;     :halign "center"
                    ;     :text "Eco Mode")
                )
            )
        )

        ; (box  :class "control-box"
        ;     :tooltip mode_text
        ;     :space-evenly "false"
        ;     :valign "fill"
        ;     :vexpand "false"
        ;     :halign "fill"
        ;     :hexpand "true"
        ;     :spacing 16

        ;     (eventbox :class "restart-button"
        ;         :cursor "pointer"
        ;         :onrightclick ""
        ;         :vexpand "false"
        ;         :valign "fill"
        ;         :hexpand "true"
        ;         :halign "center"
        ;         :onclick "./scripts/toggle-performance-mode.sh"
            
        ;         (box :orientation "h" 
        ;             :valign "center"
        ;             :vexpand "false"
