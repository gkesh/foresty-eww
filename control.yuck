(defvar kb_label "Keyboard")

(defwidget connection-box []
    ; Connections Boxes
    (box :class "control-box"
        ;tooltip "Enable/Disable Connections"
        :orientation "v"
        :space-evenly "false"
        :valign "fill"
        :vexpand "false"
        :spacing 24

        (eventbox :class "control-event-box" 
            :cursor "pointer"
            :onrightclick ""
            :vexpand "false"
            :valign "fill"
            :hexpand "false"
            :halign "fill"

            (box :orientation "h" 
                :valign "fill"
                :vexpand "false"
                :space-evenly "false"
                :spacing 24
            
                (button :class "rounded-button"
                        ;tooltip "Keyboard Backlight"
                        :onclick ""
                        (label :style "margin-left: -4px"
                                :text ""))

                (box :orientation "v" 
                    :valign "center"
                    :vexpand "false"
                    :halign "start"
                    :hexpand "false"
                    :space-evenly "false"
                    :spacing 4
                
                    (label :class "rounded-label"
                            :halign "start"
                            :text "WiFi/LAN")
                    
                    (label :class "rounded-sub-label"
                            :halign "start"
                    :text "${network_data.ap}")
                )
            )
        )

        (eventbox :class "control-event-box" 
            :cursor "pointer"
            :onrightclick ""
            :vexpand "false"
            :valign "fill"
            :hexpand "false"
            :halign "fill"
            :onclick "/home/gkesh/.config/eww/scripts/toggle-bluetooth.sh"

            (box :orientation "h" 
                :valign "fill"
                :vexpand "false"
                :space-evenly "false"
                :spacing 24
            
                (button :class "rounded-button-thin"
                        ;tooltip "Bluetooth"
                        :onclick ""
                        (label :text "${bluetooth_icon}"))

                (box :orientation "v" 
                    :valign "center"
                    :vexpand "false"
                    :halign "start"
                    :hexpand "false"
                    :space-evenly "false"
                    :spacing 4
                
                    (label :class "rounded-label"
                            :halign "start"
                            :text "Bluetooth")
                    
                    (label :class "rounded-sub-label"
                            :halign "start"
                    :text "${bluetooth_text}")
                )
            )
        )

        (eventbox :class "control-event-box" 
            :cursor "pointer"
            :onrightclick ""
            :vexpand "false"
            :valign "fill"
            :hexpand "false"
            :halign "fill"

            (box :orientation "h" 
                :valign "fill"
                :vexpand "false"
                :space-evenly "false"
                :spacing 24
            
                (button :class "rounded-button-thin"
                        ;tooltip "Airplane Mode"
                        :onclick ""
                        (label :text "󰀝"))

                (box :orientation "v" 
                    :valign "center"
                    :vexpand "false"
                    :halign "start"
                    :hexpand "false"
                    :space-evenly "false"
                    :spacing 4
                
                    (label :class "rounded-label"
                            :halign "start"
                            :text "Airplane Mode")
                    
                    (label :class "rounded-sub-label"
                            :halign "start"
                            :text "Turned Off")
                )
            )
        )
    )
)

(defwidget keyboard-button []
    ; Keyboard & Screenshot
    (box :class "control-box"
        ;tooltip "Keyboard Backlight"
        :space-evenly "false"
        :valign "fill"
        :vexpand "false"
        :spacing 18
    
        (eventbox :class "control-event-box"
            :cursor "pointer"
            :onrightclick ""
            :vexpand "false"
            :valign "fill"
            :hexpand "true"
            :halign "center"
            :onclick "/home/gkesh/.config/eww/scripts/toggle-keyboard.sh"
        
            (box :orientation "v" 
                :valign "center"
                :vexpand "false"
                :halign "center"
                :hexpand "true"
                :space-evenly "false"
                :spacing 4
                
                (label :class "large-icon"
                    :text "${kbd_icon}")
                
                (label :class "rounded-label"
                    :halign "center"
                    :text "${kb_label}")
            )
        )
    )
)

(defwidget screenshot-button []
    (box :class "control-box"
    ;tooltip "Screenshot"
    :space-evenly "false"
    :valign "fill"
    :vexpand "false"
    :spacing 18

        (eventbox :class "control-event-box" 
            :cursor "pointer"
            :onrightclick ""
            :vexpand "false"
            :valign "fill"
            :hexpand "true"
            :halign "center"
            :onclick "eww close control_popup && sleep 1 && flameshot gui &"
        
            (box :orientation "v" 
                :valign "center"
                :vexpand "false"
                :halign "center"
                :hexpand "true"
                :space-evenly "false"
                :spacing 4
                
                (label :class "large-icon"
                    :style "margin-left: -4px"
                    :text "")
                
                (label :class "rounded-label"
                    :halign "center"
                    :text "Screenshot")
            )
        )
    )
)

(defwidget power-buttons []
    (box :class "power-buttons"
        :orientation "h"
        :valign "fill"
        :vexpand "false"
        :space-evenly "false"
        :spacing 16

        (box :class "control-box"
            :tooltip "Logout"
            :space-evenly "false"
            :valign "fill"
            :vexpand "false"
            :halign "fill"
            :hexpand "true"
            :spacing 16

            (eventbox :class "logout-button"
                :cursor "pointer"
                :onrightclick ""
                :vexpand "false"
                :valign "fill"
                :hexpand "true"
                :halign "center"
                :onmiddleclick "logout"
            
                (box :orientation "h" 
                    :valign "center"
                    :vexpand "false"
                    :halign "center"
                    :hexpand "true"
                    :space-evenly "false"
                    :spacing 4

                    (label :class "large-icon"
                        :text " ")

                    (label :class "large-icon"
                        :text " ")
                    
                    (label :class "large-icon"
                        :text " 󰠜 ")
                    
                    ; (label :class "rounded-label"
                    ;     :halign "center"
                    ;     :text "Logout")
                )
            )
        )

        (box  :class "control-box"
            :tooltip "Shutdown"
            :space-evenly "false"
            :valign "fill"
            :vexpand "false"
            :halign "fill"
            :hexpand "true"
            :spacing 16

            (eventbox :class "power-button"
                :cursor "pointer"
                :onrightclick ""
                :vexpand "false"
                :valign "fill"
                :hexpand "true"
                :halign "center"
                :onmiddleclick "shutdown -P now"
            
                (box :orientation "h" 
                    :valign "center"
                    :vexpand "false"
                    :halign "center"
                    :hexpand "true"
                    :space-evenly "false"
                    :spacing 4

                    (label :class "large-icon"
                        :text " ")

                    (label :class "large-icon"
                        :text " ")
                    
                    (label :class "large-icon"
                        :text "  ")
                    
                    ; (label :class "rounded-label"
                    ;     :halign "center"
                    ;     :text "Shutdown")
                )
            )
        )

        (box  :class "control-box"
            :tooltip "Restart"
            :space-evenly "false"
            :valign "fill"
            :vexpand "false"
            :halign "fill"
            :hexpand "true"
            :spacing 16

            (eventbox :class "restart-button"
                :cursor "pointer"
                :onrightclick ""
                :vexpand "false"
                :valign "fill"
                :hexpand "true"
                :halign "center"
                :onmiddleclick "reboot -f"
            
                (box :orientation "h" 
                    :valign "center"
                    :vexpand "false"
                    :halign "center"
                    :hexpand "true"
                    :space-evenly "false"
                    :spacing 4

                    (label :class "large-icon"
                        :text " ")

                    (label :class "large-icon"
                        :text " ")
                    
                    (label :class "large-icon"
                        :text "  ")
                    
                    ; (label :class "rounded-label"
                    ;     :halign "center"
                    ;     :text "Restart")
                )
            )
        )

        (box  :class "control-box"
            :tooltip mode_text
            :space-evenly "false"
            :valign "fill"
            :vexpand "false"
            :halign "fill"
            :hexpand "true"
            :spacing 16

            (eventbox :class "restart-button"
                :cursor "pointer"
                :onrightclick ""
                :vexpand "false"
                :valign "fill"
                :hexpand "true"
                :halign "center"
                :onclick "./scripts/toggle-performance-mode.sh"
            
                (box :orientation "h" 
                    :valign "center"
                    :vexpand "false"
                    :halign "center"
                    :hexpand "true"
                    :space-evenly "false"
                    :spacing 4

                    (label :class "large-icon"
                        :text " ")

                    (label :class "large-icon"
                        :text " ")
                    
                    (label :class "large-icon"
                        :text mode_icon)
                    
                    ; (label :class "rounded-label"
                    ;     :halign "center"
                    ;     :text "Eco Mode")
                )
            )
        )
    )
)

(defwidget mic-button []
    (box :class "control-box"
        ;tooltip "Microphone"
        :space-evenly "false"
        :valign "fill"
        :vexpand "false"
        :spacing 18
    
        (eventbox :class "control-event-box" 
            :cursor "pointer"
            :onrightclick ""
            :vexpand "false"
            :valign "fill"
            :hexpand "true"
            :halign "center"
        
            (box :orientation "v" 
                :valign "center"
                :vexpand "false"
                :halign "center"
                :hexpand "true"
                :space-evenly "false"
                :spacing 4
                
                (label :class "large-icon"
                    :text "")
                
                (label :class "rounded-label"
                    :halign "center"
                    :text "Microphone")
            )
        )
    )
)

(defwidget camera-button []
    (box :class "control-box"
    ;tooltip "Camera"
    :space-evenly "false"
    :valign "fill"
    :vexpand "false"
    :spacing 18

        (eventbox :class "control-event-box" 
            :cursor "pointer"
            :onrightclick ""
            :vexpand "false"
            :valign "fill"
            :hexpand "true"
            :halign "center"
        
            (box :orientation "v" 
                :valign "center"
                :vexpand "false"
                :halign "center"
                :hexpand "true"
                :space-evenly "false"
                :spacing 4
                
                (label :class "large-icon"
                    :style "margin-left: -4px"
                    :text "󰻃")
                
                (label :class "rounded-label"
                    :halign "center"
                    :text "Screencap")
            )
        )
    )
)

(defwidget control-popup []
    (box :orientation "v" 
        :halign "fill"
        :valign "start"
        :vexpand "false"
        :hexpand "false"
        :space-evenly "false"
        :class "control-popup"
        :spacing 24
    
        (eventbox :onhoverlost "eww close control_popup"
            :vexpand "false"
            :valign "fill"
            :hexpand "false"
            :halign "fill"

            (box :orientation "v"
                :valign "fill"
                :vexpand "false"
                :space-evenly "false"
                :spacing 16

                (box :orientation "h"
                    :valign "fill"
                    :vexpand "false"
                    :space-evenly "false"
                    :spacing 16
                
                    (connection-box)
                    
                    (box :orientation "v"
                    :valign "fill"
                    :vexpand "false"
                    :space-evenly "false"
                    :spacing 16
                        (keyboard-button)

                        (screenshot-button)
                    )
                    
                    (box :orientation "v"
                    :valign "fill"
                    :vexpand "false"
                    :space-evenly "false"
                    :spacing 16
                
                        ; Camera and Mic
                        (mic-button)    

                        (camera-button)
                    )
                )

                (power-buttons)
            )
        )
    )
)

; Control Bar
(defwindow control_popup
    :monitor "eDP-1"
    :anchor "bottom left"
    :geometry (geometry :x "60px" :y "952px" :height "640px" :width "520px")
  
    (control-popup)
)
