        ;             :spacing 4

        ;             (label :class "large-icon"
        ;                 :text " ")

        ;             (label :class "large-icon"
        ;                 :text " ")
                    
        ;             (label :class "large-icon"
        ;                 :text mode_icon)
                    
        ;             ; (label :class "rounded-label"
        ;             ;     :halign "center"
        ;             ;     :text "Eco Mode")
        ;         )
        ;     )
