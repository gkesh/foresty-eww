(include "./control.yuck")
(include "./music.yuck")
(include "./calendar.yuck")

; Components
(include "./components/gpu_restart_dialog.yuck")

(defwidget bar [screen]
  (centerbox :orientation "v"
    (box :class "segment-top"
         :valign "start"
      (top :screen screen))
    (box :valign "center"
         :class "middle" 
      (middle :screen screen))
    (box :valign "end"
         :class "segment-bottom" 
      (bottom :screen screen))))

(defwidget bar_min [screen]
  (centerbox :orientation "v"
    :class "bar_2"
    (box :class "segment-top"
          :valign "start"
      (top_2 :screen screen))
    (box :valign "center"
          :class "middle" 
      (middle :screen screen))
    (box :valign "end"
          :class "segment-bottom" 
      (bottom_2 :screen screen))))

(defwidget metric [icon ?font-size]
  (box :class "metric" 
       :orientation "v"
    (label :class "metric-icon" 
           :style {font-size != "" ? "font-size: ${font-size}rem;" : ""}
           :text icon)
    (box :class "metric-content"
      (children))))

(defwidget seperator []
  (box (label :style "font-size: 1.3em; margin: 4px 0;" :text "󰇘"))
)

(defwidget app-drawer []
  (box :class "hoverable-metric"
    (eventbox :class "hoverable metric-app-drawer"
            :cursor "pointer"
            :tooltip "Rofi Menu"
            ; :timeout "10m"
            :onclick "rofi -i -show drun -modi drun -show-icons &"
            (label :style "font-size: 16px;" :class "hoverable-label" :text ""))))

(defwidget power []
  (box :class "hoverable-metric"
      :valign "fill"
      :vexpand "true"
    (eventbox :class "hoverable metric-icon metric-power"
            ; :tooltip "Rofi Power Menu"
            :vexpand "true"
            :cursor "pointer"
            :onclick "rofi -show p -modi p:$HOME/.config/rofi/.rofi-power-menu &"
            (label :class "hoverable-label" :text ""))))

(defwidget keyboard []
  (box :class "metric"
    (button :class "metric-keyboard"
            :tooltip "Keyboard Backlight"
            :onclick "/home/gkesh/.config/eww/scripts/toggle-keyboard.sh"
      kbd_icon)))

(defwidget control []
  (box :class "hoverable-metric"
      :valign "fill"
      :vexpand "true"
    (eventbox :class "hoverable"
            :cursor "pointer"
            ; :tooltip "Control Center"
            :vexpand "true"
            :onclick "eww close calendar_popup; eww open --toggle control_popup"
        (label :class "hoverable-label" :text "󰕮"))))

(defwidget bluetooth []
  (box :class {bluetooth == 1 ? "metric active" : "metric"}
    (button :class "metric-bluetooth"
            :tooltip "Bluetooth"
            :onclick "/home/gkesh/.config/eww/scripts/toggle-bluetooth.sh"
      bluetooth_icon)))

(defwidget music-button []
  (button :style "font-size: 1.5em"
          :onclick "playerctl play-pause"
          :onrightclick "eww open --toggle music_popup"
    "${music_data == "" ? "" : music_data.status == "Playing" ? "󰏤" : "󰐊"}"))

(defwidget top [screen]
  (box :orientation "v"
       :valign "start"
       :space-evenly false
       :spacing "5"

    (app-drawer)

    (metric :icon "" (music-button))

    (seperator)

    (workspaces :wsp_yuck workspaces_1_yuck)  
  ))

(defwidget top_2 [screen]
  (box :orientation "v"
        :valign "start"
        :space-evenly false
        :spacing "5"

    (app-drawer)

    (seperator)

    (workspaces :wsp_yuck workspaces_1_yuck)  
  ))

(defwidget workspaces [wsp_yuck]
  (literal :content wsp_yuck))

(defwidget middle [] (time))
(defwidget time []
  (box :orientation "v" 
       :class "time"
    hour min sec))

(defwidget bottom [screen] 
  (box :orientation "v"
       :valign "end"
       :space-evenly false
       :spacing "5"

    ;(keyboard)

    ;(bluetooth)

    (system)

    ; (volume)

    ; (brightness)

    (date)

    (control)
    
    (power)))

(defwidget bottom_2 [screen] 
  (box :orientation "v"
        :valign "end"
        :space-evenly false
        :spacing "5"

    (system)
    
    (power)))


(defwidget system []
  (eventbox
    (box :orientation "v"
          :class "metric" 
          :vexpand "false" 
          :hexpand "false" 
          :space-evenly "true"
          :tooltip "m: ${round(EWW_RAM.used_mem_perc, 0)}% | p: ${round(EWW_CPU.avg, 0)}% | b: ${battery_percent} % | w: ${network_data.ap} (${network_data.strength}%)"
          :spacing 8

      (circular-progress :value "${round(EWW_RAM.used_mem_perc, 0)}"
                          :class "circular_metric memory_metric"
                          :thickness 4
        (label :style "font-size: 12px; margin: 10px; font-family: 'Font Awesome 5 Free Solid', 'Font Awesome 5 Free';"
                :text ""))

      (circular-progress :value "${round(EWW_CPU.avg, 0)}"
                          :class "circular_metric cpu_metric"
                          :thickness 4
        (label :style "font-size: 12px; margin-right: 5px; margin-top: 2px; font-family: 'Hack Nerd Font';"
                :text ""))   

      (circular-progress :value "${network_data.strength}"
                          :class "circular_metric network_metric"
                          :thickness 4
        (label :style "font-family: 'Font Awesome 5 Free Solid', 'Font Awesome 5 Free'; ${network_data.style}"
                :text "${network_data.icon}"))
      
      (circular-progress :value "${battery_percent}"
                          :class "circular_metric battery_metric"
                          :thickness 4
        (label :style "font-size: 15px; margin: 0 10px;"
                :text battery_icon))  
    )
  )
)

(defwidget brightness []
  (box :class "volume-metric"
       :orientation "v"
       :space-evenly false
       :valign "fill"
       :vexpand false
    (eventbox :onclick "eww close volume_popup; eww open brightness_popup"
              :vexpand true
              :valign "fill"
              :cursor "pointer"
              :class "hoverable"
      (box :orientation "v"
           :valign "fill"
           :vexpand true
        (label :class "metric-icon"
                :style "font-size: 20px; margin: 8px 0 5px -7px;"
                :text "󱍖")
        (label :class "metric-text" :text "${brightness_percent}")))))

(defwidget volume []
  (box :class "volume-metric"
       :orientation "v"
       :space-evenly false
       :valign "fill"
       :vexpand false
    (eventbox :onclick "eww close brightness_popup; eww open volume_popup"
              :onrightclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
              :vexpand true
              :valign "fill"
              :cursor "pointer"
              :class "hoverable"
      (box :orientation "v"
           :valign "fill"
           :vexpand true
        (label :class "metric-icon"
                :style "font-family: 'Font Awesome 5 Free Solid', 'Font Awesome 5 Free';"
                :text "")
        (label :class "metric-text" :text "${volume}")))))

(defwidget large-sym [sym]
  (label :class "metric-icon large-symbol" :text sym))

(defwidget date []
  (eventbox :onclick "eww close control_popup; eww open --toggle calendar_popup"
            :cursor "pointer"
            :class "hoverable metric"
            :style "padding: 8px 0px;"
    (box :orientation "v"
         :halign "center"
         :class "metric-date" 
         day_word day month year)))

(defpoll battery_icon :interval "1s" :initial "0" '/home/gkesh/.config/eww/scripts/get-battery-icon.sh')
(defpoll battery_percent :interval "10s" :initial "0" '/home/gkesh/.config/eww/scripts/get-battery.sh')

(defpoll hour :interval "1s" "date +%H")
(defpoll min  :interval "1s" "date +%M")
(defpoll sec  :interval "1s" "date +%S")

(defpoll day_word :interval "10m" "date +%a | tr [:upper:] [:lower:]")
(defpoll day      :interval "10m" "date +%d")
(defpoll day_calendar      :interval "1h" '/home/gkesh/.config/eww/scripts/get-calendar-day.sh')
(defpoll day_name :interval "1h" "date +%A")
(defpoll month    :interval "1h"  "date +%m")
(defpoll month_calendar :interval "1h" "date +'%-m'")
(defpoll month_name :interval "1h" "date +%B")
(defpoll year     :interval "1h"  "date +%y")
(defpoll year_calendar     :interval "1h"  "date +%Y")
(defpoll sun_time :interval "1h" :initial "{\"sunrise\": \"Querying\", \"sunset\": \"Querying\"}"  '/home/gkesh/.config/eww/scripts/get-sun-info.sh')

(defvar kb_label "Keyboard")
(defvar bluetooth_icon "")
(defvar mode_icon "")
(defvar mode_text "")
(defvar gpu_mode_icon "")
(defvar gpu_mode_text "")
(defvar kbd_icon "")
(defvar bluetooth "")
(defvar bluetooth_text "")
(defvar workspaces_1_yuck "")
(defvar workspaces_2_yuck "")
(defvar music_bg "")

(defwindow bar_1
  :monitor "eDP-1"
  :stacking "bg"
  :geometry (geometry :x -8 :y 4 :width "55px" :height "1592px")
  :anchor "top left"
  :reserve (struts :distance "50px" :side "left")
  (bar :screen 0))

(defwindow bar_2
 :monitor "HDMI-1-0"
 :geometry (geometry :x 1872 :y 4 :width "55px" :height "1072px")
 :anchor "top right"
 :reserve (struts :distance "50px" :side "right")
 (bar_min :screen 1))

; Wifi info
(defpoll network_data :interval "5s"
  :inital `{"ap": "N/A", "strength": "0"}`
  `
  bash /home/gkesh/.config/eww/scripts/wifi-info.sh
  `)

; Volume Bar
(defwidget volume-popup []
  (eventbox :onhoverlost "eww close volume_popup"
            :vexpand true
            :valign "fill"
    (box :class "volume-metric"
       :orientation "v"
       :valign "fill"
       :vexpand false
       :width 40
      (scale :orientation "v" 
            :min 0
            :max 100 
            :flipped "true"
            :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"
            :value volume))))

(defwindow volume_popup
  :monitor "eDP-1"
  :anchor "bottom left" 
  :geometry (geometry :x "50px" :y "1235px" :height "100px" :width "40px")
  (volume-popup))

; Brightness bar
(defwidget brighness-popup []
  (eventbox :onhoverlost "eww close brightness_popup"
            :vexpand "true"
            :valign "fill"
    (box :class "volume-metric"
       :orientation "v"
       :valign "fill"
       :vexpand "false"
       :width 40
      (scale :orientation "v"
            :min 0
            :max 100
            :flipped "true"
            :onchange "xbacklight -set {}"
            :value brightness_percent))))

(defwindow brightness_popup
  :monitor "eDP-1"
  :anchor "bottom left"
  :geometry (geometry :x "50px" :y "1315px" :height "100px" :width "40px")
  (brighness-popup))

